// Схема демо-трекера «Свои».
// Все сущности, кроме Board, обязательно привязаны к доске (boardId).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  NORMAL
  IMPORTANT
}

enum TaskEventType {
  CREATED
  UPDATED
  ASSIGNED
  MOVED
  DELETED
}

model Board {
  id           String        @id @default(cuid())
  sessionToken String        @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  participants Participant[]
  tasks        Task[]
  events       TaskEvent[]

  @@index([createdAt])
}

model Participant {
  id        String   @id @default(cuid())
  boardId   String
  name      String
  color     String   @default("sage")
  createdAt DateTime @default(now())

  board Board   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks Task[]  @relation("Assignee")

  @@index([boardId])
}

model Task {
  id          String       @id @default(cuid())
  boardId     String
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  dueDate     DateTime?
  priority    TaskPriority @default(NORMAL)
  assigneeId  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  completedAt DateTime?

  board    Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  assignee Participant? @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  events   TaskEvent[]

  @@index([boardId, status])
  @@index([boardId, completedAt])
  @@index([assigneeId])
}

model TaskEvent {
  id        String        @id @default(cuid())
  boardId   String
  taskId    String?
  taskTitle String
  type      TaskEventType
  detail    String?
  actorId   String?
  actorName String?
  createdAt DateTime      @default(now())

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  task  Task?  @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([boardId, createdAt])
  @@index([taskId, createdAt])
}
